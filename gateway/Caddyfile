# /etc/caddy/Caddyfile del gateway: l'unico indirizzo pubblico, davanti a tutte le VM
monitor.tuodominio.it {
    encode zstd gzip

    # Stesso tetto del server: il gateway legge il corpo per instradare l'accesso
    request_body {
        max_size 10MB
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # Le rotte interne delle VM non si raggiungono da fuori (le blocca anche il gateway)
    respond /internal/* 404

    reverse_proxy 127.0.0.1:8080
}
