# netmon gateway: copia in /opt/netmon-gateway/.env (installa-server.sh --orchestratore lo scrive da solo)
# ATTENZIONE: niente commenti sulla stessa riga dei valori (systemd non li accetta)

# L'orchestratore (netmon con ROLE=orchestratore) sulla stessa macchina
ORCHESTRATOR=http://127.0.0.1:8000

# Lo stesso GATEWAY_SECRET del .env dell'orchestratore (/opt/netmon/.env)
GATEWAY_SECRET=cambia-questo-segreto

# VM per le pagine pubbliche e per token e sessioni senza nome (quelli creati prima del gateway).
# Vuoto: vm1 se c'è, altrimenti la prima in ordine alfabetico. Le VM le elenca l'orchestratore.
DEFAULT_VM=

# Secondi di attesa massima di una risposta dalla VM (backup ed esportazioni possono essere lenti)
UPSTREAM_TIMEOUT=60

# Indirizzo del gateway e suoi nomi precedenti (dominio cambiato, separati da virgole): chi arriva a un
# nome vecchio è rimandato a PUBLIC_URL. Li copia installa-server.sh dal .env dell'orchestratore.
PUBLIC_URL=
OLD_HOSTS=
