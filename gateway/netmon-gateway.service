[Unit]
Description=netmon - gateway davanti alle VM
After=network-online.target
Wants=network-online.target

[Service]
User=netmon-gw
WorkingDirectory=/opt/netmon-gateway
EnvironmentFile=/opt/netmon-gateway/.env
ExecStart=/opt/netmon-gateway/venv/bin/uvicorn gateway:app --host 127.0.0.1 --port 8080 --no-access-log --ws none --timeout-keep-alive 65
UMask=0077
Restart=always
RestartSec=5
MemoryMax=256M

[Install]
WantedBy=multi-user.target
