# netmon versione 1.1.20261029-200000
# netmon · permessi del server (utente netmon): solo riavvio, aggiornamento dei pacchetti della VM e
# installazione di un pacchetto netmon.zip caricato, usati dal pannello di amministrazione (/admin,
# scheda Stato VM). Nient'altro.
# Installazione:  sudo install -m 440 -o root -g root sudoers-netmon-vm /etc/sudoers.d/netmon-vm
#                 sudo visudo -c        (deve rispondere "parsed OK")
netmon ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
netmon ALL=(root) NOPASSWD: /usr/bin/systemd-run --unit=netmon-vm-upgrade --collect --quiet /usr/local/sbin/netmon-vm-upgrade
netmon ALL=(root) NOPASSWD: /usr/bin/systemd-run --unit=netmon-vm-selfupdate --collect --quiet /usr/local/sbin/netmon-vm-selfupdate
# Rollback dell'ultimo aggiornamento da pacchetto: «commit» conferma e gira subito (non riavvia
# niente); «rollback» ripristina la versione precedente e RIAVVIA il server, quindi deve girare
# in un'unità systemd separata e non dentro il servizio (altrimenti si ucciderebbe da solo).
netmon ALL=(root) NOPASSWD: /usr/local/sbin/netmon-vm-rollback commit
netmon ALL=(root) NOPASSWD: /usr/bin/systemd-run --unit=netmon-vm-rollback-run --collect --quiet /usr/local/sbin/netmon-vm-rollback rollback
# Backup completo dal pannello: chiave di firma degli aggiornamenti delle sonde (esportata nel file
# cifrato, rimessa al ripristino), così le sonde spostate su una VM nuova restano aggiornabili.
netmon ALL=(root) NOPASSWD: /usr/local/sbin/netmon-chiave-sonde esporta
netmon ALL=(root) NOPASSWD: /usr/local/sbin/netmon-chiave-sonde importa
