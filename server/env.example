# netmon versione 1.1.20261028-180000
# Genera il token con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=cambia-questo-token

# ATTENZIONE: niente commenti sulla stessa riga dei valori (systemd non li accetta)

# Ping falliti consecutivi prima dell'alert
FAIL_THRESHOLD=3

# Dispositivi a priorita' BASSA: quante volte la soglia normale (2 = il doppio dei controlli).
# Predefinito per le sonde che non hanno scelto; si cambia per sonda dalla pagina di stato
LOW_FACTOR=2

# Piano con cui nasce ogni nuovo account: basso (1 sonda, 1 FRITZ!Box, 5 dispositivi in tutto), medio, alto,
# oppure vuoto (nessun piano). Si cambia per account dal pannello (Utenti › Limiti)
NEW_USER_PLAN=basso

# Le soglie della sonda sono multipli del suo intervallo di controllo:
# con interval=120 la sonda diventa gialla dopo 180 s e rossa dopo 360 s
STALE_FACTOR=1.5
HEARTBEAT_FACTOR=3

# Intervallo assunto se la sonda non lo comunica (versioni vecchie)
DEFAULT_INTERVAL=60

# Promemoria per problemi critici ancora in corso, in minuti (0 = disattivato)
REMIND_MINUTES=60

DATA_DIR=/opt/netmon/data

# Sonde senza account ferme da più di tanti giorni: eliminate da sole con il loro storico (0 = mai)
ORPHAN_DAYS=30

# Registro amministrativo (eventi di VM, aggiornamenti e account, con le email): giorni di conservazione (0 = sempre)
ADMIN_EVENTS_DAYS=365

# --- Email: l'account da cui partono le email (es. Gmail con "password per le app") ---
# I destinatari non sono qui: ogni utente riceve gli avvisi alla propria email, gli
# amministratori i codici di verifica alla loro.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tuoindirizzo@gmail.com
SMTP_PASSWORD=password-per-le-app
SMTP_FROM=tuoindirizzo@gmail.com
# Nome del mittente che compare nelle email (facoltativo)
SMTP_FROM_NAME=netmon
# Con Brevo (UE, contratto sul trattamento dei dati incluso, consigliato per il GDPR):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SMTP_USER=il login SMTP di Brevo (es. 8a1b2c001@smtp-brevo.com)  SMTP_PASSWORD=la chiave SMTP
#   SMTP_FROM=un mittente verificato in Brevo (es. notifiche@netmonhome.net)

# --- Telegram (opzionale, consigliato): il bot da cui partono i messaggi ---
# Il chat ID non va qui: ogni utente indica il proprio in Impostazioni → Notifiche.
TELEGRAM_BOT_TOKEN=

# ntfy: ogni utente indica il proprio topic in Impostazioni → Notifiche, dove ne trova già uno
# proposto su questo server ntfy (vuoto = https://ntfy.sh). Solo se usi un server ntfy tuo:
NTFY_BASE=

# --- Indirizzo e proxy ---
# Indirizzo pubblico del server, per i link nelle email (es. https://netmonhome.net). Lo scrive installa-server.sh.
PUBLIC_URL=
# Solo con un altro proxy davanti a Caddy: i suoi IP (separati da virgole), a cui credere per X-Forwarded-For.
TRUSTED_PROXIES=
# Nomi precedenti di questa macchina (dominio cambiato), separati da virgole: Caddy li serve ancora e
# netmon rimanda browser e sonde a PUBLIC_URL. Li scrive installa-server.sh.
OLD_HOSTS=
